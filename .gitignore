# --- dependencies ---
node_modules/

# --- secrets / local environment ---
# Real credentials never belong in the repo. The .example files document the
# required variables instead. (.env.test holds the automated-test database
# credentials generated by server/scripts/lib/testpg.js.)
.env
.env.*
!.env.example
!.env.test.example

# --- local database ---
# SQLite dev database: contains seeded accounts and password hashes.
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- database backups ---
backups/

# --- runtime file storage ---
# Attachment binaries written by the server (and the test suites) at runtime.
server/data/

# --- build output ---
dist/
build/

# --- prisma generated client ---
.prisma/

# --- logs / diagnostics ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- editor / OS noise ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- binary documents: never committed ---
# A .docx is a zip of deflated XML. The secret scanner skips it (it cannot read
# it), `git grep -I` skips it, and gitleaks has no useful rule for it — so a
# production hostname or address inside one is invisible to every control this
# repository relies on. That is exactly how the live mailbox reached two
# committed domain-migration guides. Keep the documents you generate on disk and
# distribute them out of band; commit the text they came from instead.
*.docx
# The one-shot generator scripts went the same way: they hard-coded the
# production domain, the Fly app, the server IP and an absolute home-directory
# path, and nothing regenerates them, so nothing can tell they have gone stale.
scripts-make-doc/

# --- misc ---
coverage/
*.bak
*.tmp

# --- client SSR checks (transient artifacts of live-check / ssr-check) ---
client/.ssr-check/
client/ssr-check-entry.mjs

# --- AI benchmark artifacts (JSON exports / generated report / chart pages) ---
server/.bench/
server/bench-report-*.txt
server/bench-runs-*.json
server/bench-report*.html
