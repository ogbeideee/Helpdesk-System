# --- Database (Prisma / PostgreSQL on Supabase) ---
# Runtime connection used by the application (Supabase session pooler):
#   postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=""
# Direct connection used ONLY by Prisma Migrate / db push (DDL + shadow DB).
# Not used by the running application:
#   postgresql://postgres:<URL-ENCODED-PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
DIRECT_URL=""

# --- Initial administrator ---
# The very first admin cannot be created through the admin API, because that
# API requires an admin. This closes the gap exactly once: at startup, if there
# are ZERO active administrators, this account is promoted (or provisioned) as
# ADMIN. As soon as one administrator exists the mechanism is inert - changing
# this value can never create a second admin. Any admin can then promote others.
INITIAL_ADMIN_EMAIL=

# --- Auth ---
# Secret used to sign agent session JWTs. Generate e.g. with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public HTTPS base URL of this server (used in outbound email links),
# e.g. https://helpdesk.yourcompany.com
PORTAL_BASE_URL=

# --- Microsoft Graph / Microsoft 365 (Entra) integration -------------------
# NOT REQUIRED for local development. The system runs fully without these:
# email ingestion stays off and notifications are logged to the console.
# IMAP ingestion (see below) works independently of this block.
#
# CONNECTING THE REAL TENANT LATER — full checklist:
#   1. In the Entra admin center, register an app (single tenant).
#   2. Add a client secret; copy its VALUE (not its ID) into
#      GRAPH_CLIENT_SECRET.
#   3. Grant the app APPLICATION permissions Mail.ReadWrite + Mail.Send and
#      get admin consent.
#   4. Create/identify the shared mailbox that receives ticket email and set
#      GRAPH_SHARED_MAILBOX.
#   5. Set GRAPH_TENANT_ID + GRAPH_CLIENT_ID from the app registration
#      overview, leave GRAPH_ENABLED unset (or true), and restart the server.
#   6. Administrators can check the connection on the "Microsoft 365" admin
#      page ("Validate connection") and via GET /api/microsoft-365.
# Auth is the OAuth 2.0 client-credential flow; tokens are held in memory
# only and never written to the database, logs or audit events.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Explicit on/off switch for the Microsoft 365 integration. Leave unset for
# the default behaviour (on whenever the four values above are complete).
#   GRAPH_ENABLED=false  -> configured but disabled; IMAP and everything else
#                           keep working, no Graph calls are ever made
#   GRAPH_ENABLED=true   -> on (still requires the values above)
GRAPH_ENABLED=

# Microsoft 365 SHARED MAILBOX that receives inbound ticket emails.
# The app only ever reads this mailbox - never individual employee mailboxes.
GRAPH_SHARED_MAILBOX=ithelpdesk@mrsholdings.com

# Distribution list that receives the new-ticket broadcast email
GRAPH_BROADCAST_DL=

# Inbox poll cadence in milliseconds (default: 120000 = 2 minutes)
MAIL_POLL_INTERVAL_MS=120000

# --- Ingestion safety guards ---
# Protects a real mailbox the first time the integration is switched on:
# without these, every unread message in the inbox would become a ticket.
#
# Only mail newer than this many hours is ingested (default 24). Set to 0 to
# disable the age limit entirely.
GRAPH_INGEST_MAX_AGE_HOURS=24
# Absolute ISO cutoff; wins over the rolling window when set, e.g.
#   GRAPH_INGEST_SINCE=2026-09-01T00:00:00Z
GRAPH_INGEST_SINCE=
# Messages fetched per poll cycle (default 25, max 100).
GRAPH_POLL_BATCH_SIZE=25
# true -> authenticate, read and parse, but never create tickets and never
# mark anything read. Useful for a first live dry run.
GRAPH_DRY_RUN=false

# --- Microsoft Graph change notifications (webhook) ---
# OPTIONAL. Leave WEBHOOK_PUBLIC_URL empty for local development: the app logs
# that webhook mode is unavailable and keeps ingesting mail by polling. No
# tunnel (ngrok or otherwise) is required.
#
# In production set the public HTTPS base URL of this server. Graph will be
# subscribed to POST notifications to <WEBHOOK_PUBLIC_URL>/api/webhooks/microsoft-graph
# The URL must be https and reachable from Microsoft.
WEBHOOK_PUBLIC_URL=

# Shared secret echoed back by Graph in every notification, used to verify the
# callback really belongs to our subscription. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random value is generated per process — set it explicitly so a
# restart keeps validating the existing subscription.
GRAPH_WEBHOOK_CLIENT_STATE=

# How often the subscription is checked and renewed (default: 1800000 = 30 min).
# Graph subscriptions expire after ~3 days; renewal is automatic.
GRAPH_SUBSCRIPTION_RENEW_INTERVAL_MS=1800000

# --- IMAP ingestion (alternative to Graph) --------------------------------
# A second supported email source that feeds the SAME ticket-intake pipeline
# as Graph. Works with any standard IMAP provider (Exchange, Gmail with an app
# password, Dovecot, etc.) — nothing is provider-specific.
#
# The integration is OFF unless IMAP_HOST, IMAP_USER and IMAP_PASSWORD are all
# set. Graph and IMAP can coexist; if both point at the same mailbox, the
# shared RFC Message-ID identity prevents the same email from becoming two
# tickets. Passwords are never logged, stored in the database, or returned by
# any API; /api/health reports only whether IMAP is enabled and its host.
IMAP_HOST=
IMAP_PORT=
# true (default) = implicit TLS, usually port 993. false = plaintext/STARTTLS
# on port 143 for servers that do not offer TLS.
IMAP_SECURE=
IMAP_USER=
IMAP_PASSWORD=
# Folder to poll (default INBOX). Never polled with deletions — messages are
# only ever marked as seen after they are safely processed.
IMAP_MAILBOX=
# How often the mailbox is polled in milliseconds. 0 disables the timer
# entirely (default 120000 = 2 minutes).
IMAP_POLL_INTERVAL_MS=120000
# Messages fetched per poll cycle (default 25, max 100).
IMAP_POLL_BATCH_SIZE=25
# Set to false only for servers with self-signed certificates that cannot be
# trusted via the system trust store. Leave empty in production.
IMAP_TLS_REJECT_UNAUTHORIZED=
# Messages larger than this many bytes are truncated before MIME decoding, so
# a pathological message can never exhaust the process. Default 26214400
# (25 MB — every mainstream provider rejects mail below this). 0 disables.
IMAP_MAX_MESSAGE_BYTES=

# --- IMAP Gmail OAuth2 (XOAUTH2) — optional --------------------------------
# For Gmail accounts where an App Password is unavailable. When ALL THREE are
# set, IMAP authenticates with OAuth2/XOAUTH2 using IMAP_USER as the Gmail
# address (imap.gmail.com, port 993) and IMAP_PASSWORD is ignored. When any of
# them is set but not all, the server reports the configuration as invalid and
# keeps using IMAP_PASSWORD. Secrets are read from the environment only — they
# are never logged, stored in the database, or returned by any API.
# The refresh token must be issued for the Gmail IMAP scope:
#   https://mail.google.com/
# (one-off consent flow outside this app, e.g. oauth2l or the OAuth Playground,
# with "Refresh token" access; the server exchanges it for short-lived access
# tokens automatically).
IMAP_OAUTH2_CLIENT_ID=
IMAP_OAUTH2_CLIENT_SECRET=
IMAP_OAUTH2_REFRESH_TOKEN=

# --- Email parser limits --------------------------------------------------
# Bounds on what one inbound message can make the parser do. Defaults are
# sane for a helpdesk; every value has a hard minimum floor.
# Maximum body characters kept from one message (default 200000). Oversized
# bodies are truncated with a visible "[message truncated]" marker.
PARSER_MAX_BODY_CHARS=
# Maximum subject characters (default 998, the practical RFC 5322 line limit).
PARSER_MAX_SUBJECT_CHARS=
# Maximum recipients kept per list (to/cc/reply-to, default 50).
PARSER_MAX_RECIPIENTS=
# Maximum identifiers kept from a thread chain (default 50).
PARSER_MAX_THREAD_IDS=
# Maximum attachment metadata entries kept per message (default 25).
PARSER_MAX_ATTACHMENTS=

# --- Workload, unattended tickets and rebalancing ---
# How long a NEW ticket must sit before a teammate may take it (default 4).
UNATTENDED_CLAIM_HOURS=4
# Open-ticket gap that counts as a significant imbalance (default 3).
REBALANCE_THRESHOLD=3
# How often the background balancer runs. 0 disables it entirely.
REBALANCE_INTERVAL_MS=300000
# Hard cap on moves per cycle, so balancing can never spin (default 5).
REBALANCE_MAX_MOVES=5

# --- Handovers ------------------------------------------------------------
# Defaults only. An administrator can change both from the Handovers screen
# (they are stored in the database and override what is set here).
# Maximum handover requests one agent can be actively holding; further
# requests queue in FIFO order and activate as slots free up.
HANDOVER_PENDING_LIMIT=2
# How long an unanswered request stays live. The clock pauses while the
# recipient is unavailable.
HANDOVER_EXPIRY_MINUTES=1440
# How often expired requests are swept up. 0 disables the sweeper.
HANDOVER_SWEEP_INTERVAL_MS=60000

# --- SLA ------------------------------------------------------------------
# How often open tickets' SLA cycles are inspected for approaching breach
# (25% of the target remaining) and breach. 0 disables the sweeper.
SLA_SWEEP_INTERVAL_MS=60000
#
# SLA policy defaults — every one of these can be changed at runtime by an
# administrator on the SLA Settings screen (stored in the database, which
# wins over what is set here). They are the built-in values a fresh install
# runs on; leave them unset to use the approved policy.
# Response SLA target in working minutes (default 60 = one working hour).
SLA_RESPONSE_TARGET_MINUTES=60
# Resolution targets in working hours, per priority.
SLA_RESOLUTION_HOURS_CRITICAL=4
SLA_RESOLUTION_HOURS_HIGH=8
SLA_RESOLUTION_HOURS_MODERATE=24
SLA_RESOLUTION_HOURS_LOW=72
# Working calendar: first/last working hour of the day and the working days
# (comma-separated day names or 0–6, 0 = Sunday).
SLA_WORKDAY_START_HOUR=8
SLA_WORKDAY_END_HOUR=17
SLA_WORKING_DAYS=mon-fri
SLA_TIMEZONE=Africa/Lagos

# Attachment storage (object storage for inbound email attachments)
# Private local directory; never web-served, never PostgreSQL. Binaries are
# reached ONLY through the authorized download endpoint.
ATTACHMENT_STORAGE=local
ATTACHMENT_STORAGE_DIR=
# Limits: per-attachment size (default 25 MB), attachments per message
# (default 10) and total per message (default 100 MB). Oversized attachments
# are rejected safely and logged — the email itself still becomes a ticket.
ATTACHMENT_MAX_BYTES=
ATTACHMENT_MAX_PER_MESSAGE=
ATTACHMENT_MAX_TOTAL_BYTES=
