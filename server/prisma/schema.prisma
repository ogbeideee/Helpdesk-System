generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Assignment group (IT team). "Team" is the historical table name; it is the
// AssignmentGroup entity the routing rules and tickets refer to.
model Team {
  id           Int              @id @default(autoincrement())
  key          String           @unique
  name         String
  description  String?
  // An inactive group is kept for history but is never a routing target.
  isActive     Boolean          @default(true)
  // The fallback group when no routing rule matches (General IT Support).
  isDefault    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  agents       Agent[]
  memberships  TeamMembership[]
  tickets      Ticket[]         @relation("TicketCurrentGroup")
  originated   Ticket[]         @relation("TicketOriginGroup")
  routingRules RoutingRule[]
  slaCycles    TicketSlaCycle[]
}

// Agent ↔ Assignment Group membership (the join table for multi-group).
//
// This is the single source of truth for "who belongs to which group, and who
// leads it". An agent can belong to up to `MAX_GROUPS_PER_AGENT` groups and can
// lead several of them at once; lead status lives HERE, on the membership row —
// never on Agent (there is no "lead" role) and never on Team (no lead column).
// Leading a group does not make the account an ADMIN.
//
// Business rules enforced in src/services/groupMembershipService.js:
//   - at most MAX_GROUPS_PER_AGENT memberships per agent (SQLite cannot
//     express this as a table constraint)
//   - a group has exactly one lead — additionally guarded by the partial
//     unique index `TeamMembership_single_lead` created in the migration
//     (one row with isLead = 1 per team)
//   - only an existing member can be a group's lead
//
// The legacy single-column `Agent.teamId` is retained for the transition
// phase because routing and workload still read it. Every path that writes
// memberships keeps it in sync; the next phase flips readers over to this
// table and drops the column.
model TeamMembership {
  id        Int      @id @default(autoincrement())
  agentId   Int
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Lead status belongs to the user↔group relationship.
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // The same (agent, group) pair can only ever exist once.
  @@unique([agentId, teamId])
  @@index([teamId])
}

// Configurable routing rule: keywords + category -> assignment group,
// optionally a preferred agent and a minimum skill level.
// Evaluated in `priority` order; see src/services/routingService.js.
model RoutingRule {
  id                Int      @id @default(autoincrement())
  name              String
  // Newline- or comma-separated keywords. Matching is deterministic and
  // punctuation/case insensitive (see normaliseKeyword).
  keywords          String   @default("")
  // One of the four fixed ticket categories, or null to match any category.
  category          String?
  teamId            Int
  team              Team     @relation(fields: [teamId], references: [id])
  preferredAgentId  Int?
  preferredAgent    Agent?   @relation("RoutingPreferredAgent", fields: [preferredAgentId], references: [id])
  minimumSkillLevel Int?
  // Lower number = evaluated first = wins. Specific rules get a lower number.
  priority          Int      @default(100)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([isActive, priority])
}

// Administrative history for routing rules. ruleId is intentionally not a
// foreign key so a deleted rule keeps its audit trail.
model RoutingRuleAuditLog {
  id        Int      @id @default(autoincrement())
  ruleId    Int?
  ruleName  String
  action    String // created | updated | activated | deactivated | deleted
  changes   String?
  actor     String   @default("system")
  createdAt DateTime @default(now())

  @@index([ruleId])
  @@index([action])
}

// The single user record for the whole product. "Agent" is the historical
// table name; it holds every person who can sign in, whatever their role.
// There is deliberately no second user system.
model Agent {
  id                      Int               @id @default(autoincrement())
  name                    String
  email                   String            @unique
  passwordHash            String? // null once an account is Entra-only
  // "user" | "agent" | "admin" — see src/services/userService.js (ROLES).
  // New sign-ins default to "agent"; "admin" is only ever granted by an
  // existing admin or the one-time initial-admin bootstrap.
  role                    String            @default("agent")
  // Account enabled. An inactive account cannot sign in and receives no work.
  isActive                Boolean           @default(true)
  // Currently accepting new assignments. Distinct from isActive: an agent on
  // leave stays active (can sign in) but unavailable (gets no new tickets).
  isAvailable             Boolean           @default(true)
  // Transition field: the agent's primary assignment group. Routing and
  // workload still read this; the membership join table (TeamMembership) is
  // the source of truth for multi-group membership. See TeamMembership.
  teamId                  Int?
  team                    Team?             @relation(fields: [teamId], references: [id])
  memberships             TeamMembership[]
  skillLevel              Int               @default(1) // 1 = junior, 2 = standard, 3 = senior
  lastAssignedAt          DateTime?
  // Identity-provider linkage, ready for Microsoft Entra ID. Not used yet:
  // no Entra authentication is implemented.
  externalId              String?           @unique
  externalProvider        String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @default(now()) @updatedAt
  assignedTickets         Ticket[]
  comments                Comment[]
  auditEvents             UserAuditLog[]    @relation("UserAuditSubject")
  preferredForRules       RoutingRule[]     @relation("RoutingPreferredAgent")
  notifications           Notification[]    @relation("AgentNotifications")
  handoversRaised         HandoverRequest[] @relation("HandoverRequester")
  handoversReceived       HandoverRequest[] @relation("HandoverTarget")
  handoversSuggested      HandoverRequest[] @relation("HandoverSuggested")
  authoredAuditEvents     AuditEvent[]      @relation("AuditEventActor")
  slaCyclesFirstResponded TicketSlaCycle[]  @relation("SlaCycleFirstResponder")
  slaCyclesOwned          TicketSlaCycle[]  @relation("SlaCycleOwner")
  availabilityPeriods     AgentAvailabilityPeriod[] @relation("AgentAvailabilityPeriodSubject")
  availabilityPeriodsActed AgentAvailabilityPeriod[] @relation("AgentAvailabilityPeriodActor")
}

// Agent Unavailability Timeline: one row per span of availability state
// (online / unavailable / offline). A period opens when the agent's state
// really changes — through the availability transition paths, never elsewhere
// — and stays open (endedAt null) until the next transition closes it.
// Closed periods are immutable history; same-state updates record nothing.
// Pure history: nothing here feeds assignment, handover or SLA decisions.
model AgentAvailabilityPeriod {
  id            Int      @id @default(autoincrement())
  agentId       Int
  agent         Agent    @relation("AgentAvailabilityPeriodSubject", fields: [agentId], references: [id], onDelete: Cascade)
  // The state this period covers: 'online' | 'unavailable' | 'offline'.
  state         String
  // The state before this period began. Null for the first recorded period of
  // an agent: history starts at the first observed transition, and no period
  // is invented for states that predate the timeline.
  previousState String?
  startedAt     DateTime
  // Null while this is the agent's current period.
  endedAt       DateTime?
  // Who drove the change. Null when the actor row is gone (or systemic).
  actorId       Int?
  actor         Agent?   @relation("AgentAvailabilityPeriodActor", fields: [actorId], references: [id], onDelete: SetNull)
  // 'self' — the agent changed their own state; 'admin' — an administrator
  // (state endpoint or PATCH) drove it.
  source        String
  note          String?
  createdAt     DateTime @default(now())

  @@index([agentId, startedAt])
  @@index([endedAt])
  @@index([actorId])
}

// Administrative history for user records: creation, role changes,
// activation, availability, assignment group and skill level.
// Ticket history stays in TicketAuditLog — these are separate concerns.
model UserAuditLog {
  id        Int      @id @default(autoincrement())
  agentId   Int
  agent     Agent    @relation("UserAuditSubject", fields: [agentId], references: [id], onDelete: Cascade)
  action    String // created | role_changed | activated | deactivated | availability_changed | group_changed | skill_changed
  field     String?
  fromValue String?
  toValue   String?
  actor     String   @default("system")
  note      String?
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([action])
}

// Sequence counter backing human-readable ticket numbers (INC-000001).
// year = 0 row is the global counter for the current numbering scheme.
model TicketSequence {
  year Int @id
  last Int @default(0)
}

model Ticket {
  id                  Int               @id @default(autoincrement())
  ticketNumber        String            @unique // e.g. HD-2026-000042
  shortDescription    String
  body                String            @default("")
  category            String            @default("Inquiry / Help")
  priority            String            @default("medium")
  state               String            @default("NEW")
  source              String            @default("email") // "email" | "portal"
  resolution          String?
  requesterEmail      String
  requesterName       String?
  graphMessageId      String?           @unique
  // RFC 5322 Message-ID (angle brackets stripped). Graph and IMAP both supply
  // it, so it is the one identity shared across ingestion sources: polling the
  // same message through a second configured source can never create a second
  // ticket, and In-Reply-To/References threading matches on it.
  internetMessageId   String?           @unique
  graphConversationId String?
  teamId              Int?
  team                Team?             @relation("TicketCurrentGroup", fields: [teamId], references: [id])
  // The group the ticket was first routed to. Set once at creation and never
  // changed, even when the current assignment group moves.
  originatingTeamId   Int?
  originatingTeam     Team?             @relation("TicketOriginGroup", fields: [originatingTeamId], references: [id])
  assignedAgentId     Int?
  assignedAgent       Agent?            @relation(fields: [assignedAgentId], references: [id])
  dueAt               DateTime?
  // SLA foundation — current-cycle mirrors only; the authoritative per-cycle
  // history lives in TicketSlaCycle / TicketSlaEvent.
  //   firstResponseAt:  when the first agent response was recorded
  //   responseDueAt:    response SLA due instant (1 working hour, calendar-aware)
  //   responseBreached: latched once the response clock has breached
  firstResponseAt     DateTime?
  responseDueAt       DateTime?
  responseBreached    Boolean           @default(false)
  resolvedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  auditLogs           TicketAuditLog[]
  auditEvents         AuditEvent[]      @relation("TicketAuditEvents")
  comments            Comment[]
  attachments         Attachment[]   @relation("TicketAttachments")
  notifications       Notification[]
  handovers           HandoverRequest[]
  slaCycles           TicketSlaCycle[]
  slaEvents           TicketSlaEvent[]

  @@index([state])
  @@index([graphConversationId])
  @@index([dueAt])
}

model TicketAuditLog {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromState String?
  toState   String
  actor     String   @default("system")
  note      String?
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Comment {
  id             Int      @id @default(autoincrement())
  ticketId       Int
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorAgentId  Int?
  authorAgent    Agent?   @relation(fields: [authorAgentId], references: [id])
  authorName     String   @default("")
  authorEmail    String   @default("")
  isRequester    Boolean  @default(false)
  isInternal     Boolean  @default(false)
  viaEmail       Boolean  @default(false)
  body           String
  // Set for activities created from an inbound Graph/email message. Unique so a
  // redelivered notification can never append the same reply twice.
  graphMessageId String?  @unique
  // RFC 5322 Message-ID (angle brackets stripped) — the cross-source identity
  // for replies, matched against In-Reply-To/References chains.
  internetMessageId String?  @unique
  attachments    Attachment[] @relation("CommentAttachments")
  createdAt      DateTime @default(now())

  @@index([ticketId])
}

// Microsoft Graph change-notification subscription state. Persisted so a
// restart reuses (and renews) the live subscription instead of orphaning it.
model GraphSubscription {
  id                 Int       @id @default(autoincrement())
  subscriptionId     String    @unique
  resource           String
  notificationUrl    String
  clientState        String
  expirationDateTime DateTime
  lastRenewedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Admin-configurable keyword rules the email parser evaluates when processing
// inbound mail. A rule influences ONLY the fields it explicitly sets (category,
// priority, assignment group) — a match never silently changes anything else.
// Keywords are stored as a JSON array of literal phrases; matching is
// case-insensitive, whitespace-tolerant and word-bounded, with no user-supplied
// regular expressions.
model EmailParsingRule {
  id         Int      @id @default(autoincrement())
  name       String
  keywords   String
  // "subject" | "body" | "both"
  scope      String   @default("both")
  category   String?
  priority   String?
  // Assignment group by Team.key, resolved to a team id at intake time.
  teamKey    String?
  // Lower number wins when several rules match; ties break by id.
  precedence Int      @default(100)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([enabled, precedence])
}

// An inbound email attachment. Only metadata and the PRIVATE storage key live
// here — binaries are in object storage (never PostgreSQL). The storage key is
// generated server-side and never derives from the filename; the filename is
// stored sanitized, for display only.
model Attachment {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket   @relation("TicketAttachments", fields: [ticketId], references: [id], onDelete: Cascade)
  // The comment the attachment arrived with (null for ticket-level context).
  commentId  Int?
  comment    Comment? @relation("CommentAttachments", fields: [commentId], references: [id], onDelete: Cascade)
  // Display filename, sanitized. Never a storage path.
  filename   String
  mimeType   String   @default("application/octet-stream")
  size       Int
  // Source identity of the email the attachment arrived with.
  messageId  String?
  source     String?
  // Object-storage key, generated server-side. Unique. Never exposed.
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([ticketId])
  @@index([commentId])
  @@index([messageId])
}

// In-app notification for an agent. Email is sent separately through the
// existing notification service (src/mailer.js); this is the in-product feed,
// so an agent who was not watching their inbox still sees what happened to
// their tickets.
model Notification {
  id        Int       @id @default(autoincrement())
  agentId   Int
  agent     Agent     @relation("AgentNotifications", fields: [agentId], references: [id], onDelete: Cascade)
  ticketId  Int?
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  // ticket_taken | ticket_reassigned | ticket_rebalanced | availability_forced
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([agentId, readAt])
  @@index([ticketId])
}

// Agent-to-agent ticket handover.
//
// A handover is an OFFER: the ticket does not change owner until the target
// accepts. Everything about who may hold a ticket, how it moves and how people
// are told lives in the existing assignment/workload/notification services —
// this record only tracks the offer's lifecycle.
//
// status: PENDING | QUEUED | ACCEPTED | DECLINED | CANCELLED | EXPIRED
// Completed rows are never deleted: the ticket history is the chain of them.
model HandoverRequest {
  id               Int    @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // The agent giving the ticket away (its owner at the time of the request).
  requestedById    Int
  requestedBy      Agent  @relation("HandoverRequester", fields: [requestedById], references: [id])
  // The agent being asked to take it.
  targetAgentId    Int
  targetAgent      Agent  @relation("HandoverTarget", fields: [targetAgentId], references: [id])
  // Set when the target proposes somebody else instead. Advisory only: no
  // request is created for them, the original agent decides.
  suggestedAgentId Int?
  suggestedAgent   Agent? @relation("HandoverSuggested", fields: [suggestedAgentId], references: [id])

  status       String  @default("PENDING")
  note         String?
  responseNote String?
  // Who ended the request, for the history line ("Cancelled by ...").
  resolvedBy   String?

  // Queue position is FIFO by id among QUEUED rows for the same target, so it
  // is derived rather than stored and can never drift.
  queuedAt    DateTime?
  // When the request became PENDING; the expiry clock starts here.
  activatedAt DateTime?
  expiresAt   DateTime?
  // Expiry is paused while the target is unavailable: expiresAt is cleared and
  // the remaining time parked here until they are available again.
  pausedAt    DateTime?
  remainingMs Int?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetAgentId, status])
  @@index([ticketId])
  @@index([status, expiresAt])
}

// Administrator-configurable runtime settings, as strings.
// Deliberately tiny: env vars supply the defaults, this table only holds
// values an administrator has actually overridden.
model Setting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt
}

// ---------------------------------------------------------------------------
// Unified audit trail — one append-only record of every important action.
//
// Rows are written ONLY by trusted backend code (src/services/auditService.js)
// inside the same transaction as the business operation. The frontend cannot
// create audit events and calling the API another way cannot bypass them,
// because every instrumented write path goes through a service that records
// the event itself.
//
// Append-only from the application's normal interfaces: nothing in the
// service layer or the API updates or deletes these rows.
//
// Sensitive values never reach this table: before anything is stored,
// auditService redacts credential-shaped keys (password, token, secret, hash,
// ...) and truncates long free text. The full text belongs to the entity,
// not to the trail.
//
// ticketId is a soft link that makes "audit history for this ticket" a cheap
// indexed lookup. It is SetNull, so even deleting a ticket leaves the record
// that the deletion happened.
model AuditEvent {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  // Who performed the action. actorId is SetNull: the trail survives account
  // deletion and actorLabel keeps the human-readable name either way.
  actorId     Int?
  actor       Agent?   @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel  String   @default("system")
  // What happened, e.g. ticket.created | ticket.assigned | handover.accepted
  action      String
  // What it happened to.
  entityType  String // Ticket | Comment | HandoverRequest | Agent | Team | RoutingRule | Setting
  entityId    Int?
  // Human-readable entity reference that survives deletion (INC-…, rule name…)
  entityLabel String?
  // Per-ticket retrieval (ticket-related events only).
  ticketId    Int?
  ticket      Ticket?  @relation("TicketAuditEvents", fields: [ticketId], references: [id], onDelete: SetNull)
  // Before/after snapshots of the changed fields (JSON strings, redacted).
  fromValue   String?
  toValue     String?
  // Human-readable one-line description.
  description String
  // Extra structured context (JSON string, redacted).
  metadata    String?

  @@index([ticketId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// SLA foundation.
//
// Approved policy this schema supports (schema only — no business logic yet):
//   - Response SLA: 1 working hour from ticket creation to the first agent
//     response. Working calendar: Mon-Fri 08:00-17:00 Africa/Lagos; time
//     outside the calendar (evenings, weekends, SlaHoliday dates) does not
//     count. The calendar parameters live in code/settings — only holiday
//     DATES are data.
//   - Resolution SLA: the existing priority-based targets are unchanged and
//     Ticket.dueAt remains the live resolution target.
//   - No waiting/pending state; the clock keeps running during agent
//     unavailability and handovers; reopening starts a NEW SLA cycle while
//     the previous cycle's outcome is preserved.
//
// Deliberately NOT modelled: per-ticket pause/resume state. Elapsed working
// time is computed from timestamps against the calendar + SlaHoliday, so no
// pause columns are required. (HandoverRequest.remainingMs stays the only
// duration accumulator in the product — it belongs to handover expiry.)

// One row per SLA cycle of a ticket. Cycle 1 starts at ticket creation; every
// reopen (requester reply on a RESOLVED/CLOSED ticket) starts the next one. A
// cycle is closed out when its ticket reaches RESOLVED and its row is never
// rewritten afterwards — a reopened ticket can never overwrite the SLA result
// of its previous cycle. Durations are effective working time in integer
// milliseconds (same convention as HandoverRequest.remainingMs).
model TicketSlaCycle {
  id          Int    @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // 1-based, unique per ticket.
  cycleNumber Int

  // Cycle window. startedAt is the ticket's creation (cycle 1) or the reopen
  // instant (later cycles). endedAt is the instant this cycle's ticket
  // reached RESOLVED; null while this is the ticket's active cycle.
  startedAt  DateTime
  endedAt    DateTime?
  resolvedAt DateTime?

  // Targets for THIS cycle, frozen when the cycle starts. Ticket.responseDueAt
  // and Ticket.dueAt are the live mirrors. A priority change recomputes the
  // live targets from the original creation time (approved policy 8) and
  // writes a target_changed event; this row carries what applied to the cycle.
  responseDueAt        DateTime?
  resolutionDueAt      DateTime?
  // Precomputed "25% of the applicable SLA time remains" instants (approved
  // policy 9), so the future approaching-breach sweep is an indexed range
  // scan rather than a recomputation. Null when no approach instant exists.
  responseApproachAt   DateTime?
  resolutionApproachAt DateTime?

  // Response outcome.
  firstResponseAt  DateTime?
  // Attribution (approved policy 11): the agent who made the first response,
  // plus the owner and assignment group the cycle ended with.
  firstResponderId Int?
  firstResponder   Agent?    @relation("SlaCycleFirstResponder", fields: [firstResponderId], references: [id], onDelete: SetNull)
  assignedAgentId  Int?
  assignedAgent    Agent?    @relation("SlaCycleOwner", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  teamId           Int?
  team             Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Effective working-time durations.
  responseDurationMs   Int?
  resolutionDurationMs Int?

  // Latched outcomes, plus once-only flags so the future approaching-breach
  // sweep fires at most one event per clock per cycle.
  responseBreached     Boolean @default(false)
  resolutionBreached   Boolean @default(false)
  responseApproached   Boolean @default(false)
  resolutionApproached Boolean @default(false)

  // "live" = recorded as it happened; "backfill" = derived from existing
  // history for tickets created before the SLA feature.
  source String @default("live")

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  ticketSlaEvents TicketSlaEvent[]

  @@unique([ticketId, cycleNumber])
  @@index([assignedAgentId, endedAt])
  @@index([teamId, endedAt])
  @@index([responseDueAt])
  @@index([resolutionDueAt])
}

// Append-only SLA timeline. One closed set of types, enforced in application
// code (String column, matching the schema's state/status convention):
//   target_created | target_changed | approaching_breach | breach
//   response_recorded | cycle_restarted
// `clock` says which SLA the event refers to ("response" or "resolution").
// `at` is the event time (historical instants for backfilled rows); createdAt
// is when the row was written.
model TicketSlaEvent {
  id        Int             @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Cycle the event belongs to; SetNull so no cycle cleanup can ever
  // silently delete timeline entries.
  cycleId   Int?
  cycle     TicketSlaCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  type      String
  clock     String?
  at        DateTime
  actor     String          @default("system")
  detail    String?
  metadata  String?
  createdAt DateTime        @default(now())

  @@index([ticketId, at])
  @@index([cycleId])
}

// Public holidays that pause SLA time (approved calendar: Nigerian public
// holidays). Data rows, not code, so the calendar can be maintained without a
// deployment. `date` is a calendar day (PostgreSQL DATE, interpreted in
// Africa/Lagos) on which no working time accrues.
model SlaHoliday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
