generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Assignment group (IT team). "Team" is the historical table name; it is the
// AssignmentGroup entity the routing rules and tickets refer to.
model Team {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  // An inactive group is kept for history but is never a routing target.
  isActive    Boolean  @default(true)
  // The fallback group when no routing rule matches (General IT Support).
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  agents      Agent[]
  tickets     Ticket[] @relation("TicketCurrentGroup")
  originated  Ticket[] @relation("TicketOriginGroup")
  routingRules RoutingRule[]
}

// Configurable routing rule: keywords + category -> assignment group,
// optionally a preferred agent and a minimum skill level.
// Evaluated in `priority` order; see src/services/routingService.js.
model RoutingRule {
  id                Int      @id @default(autoincrement())
  name              String
  // Newline- or comma-separated keywords. Matching is deterministic and
  // punctuation/case insensitive (see normaliseKeyword).
  keywords          String   @default("")
  // One of the four fixed ticket categories, or null to match any category.
  category          String?
  teamId            Int
  team              Team     @relation(fields: [teamId], references: [id])
  preferredAgentId  Int?
  preferredAgent    Agent?   @relation("RoutingPreferredAgent", fields: [preferredAgentId], references: [id])
  minimumSkillLevel Int?
  // Lower number = evaluated first = wins. Specific rules get a lower number.
  priority          Int      @default(100)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([isActive, priority])
}

// Administrative history for routing rules. ruleId is intentionally not a
// foreign key so a deleted rule keeps its audit trail.
model RoutingRuleAuditLog {
  id        Int      @id @default(autoincrement())
  ruleId    Int?
  ruleName  String
  action    String   // created | updated | activated | deactivated | deleted
  changes   String?
  actor     String   @default("system")
  createdAt DateTime @default(now())

  @@index([ruleId])
  @@index([action])
}

// The single user record for the whole product. "Agent" is the historical
// table name; it holds every person who can sign in, whatever their role.
// There is deliberately no second user system.
model Agent {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  passwordHash    String?   // null once an account is Entra-only
  // "user" | "agent" | "admin" — see src/services/userService.js (ROLES).
  // New sign-ins default to "agent"; "admin" is only ever granted by an
  // existing admin or the one-time initial-admin bootstrap.
  role            String    @default("agent")
  // Account enabled. An inactive account cannot sign in and receives no work.
  isActive        Boolean   @default(true)
  // Currently accepting new assignments. Distinct from isActive: an agent on
  // leave stays active (can sign in) but unavailable (gets no new tickets).
  isAvailable     Boolean   @default(true)
  teamId          Int?
  team            Team?     @relation(fields: [teamId], references: [id])
  skillLevel      Int       @default(1) // 1 = junior, 2 = standard, 3 = senior
  lastAssignedAt  DateTime?
  // Identity-provider linkage, ready for Microsoft Entra ID. Not used yet:
  // no Entra authentication is implemented.
  externalId       String?  @unique
  externalProvider String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  assignedTickets Ticket[]
  comments        Comment[]
  auditEvents     UserAuditLog[] @relation("UserAuditSubject")
  preferredForRules RoutingRule[]  @relation("RoutingPreferredAgent")
  notifications   Notification[] @relation("AgentNotifications")
  handoversRaised    HandoverRequest[] @relation("HandoverRequester")
  handoversReceived  HandoverRequest[] @relation("HandoverTarget")
  handoversSuggested HandoverRequest[] @relation("HandoverSuggested")
}

// Administrative history for user records: creation, role changes,
// activation, availability, assignment group and skill level.
// Ticket history stays in TicketAuditLog — these are separate concerns.
model UserAuditLog {
  id        Int      @id @default(autoincrement())
  agentId   Int
  agent     Agent    @relation("UserAuditSubject", fields: [agentId], references: [id], onDelete: Cascade)
  action    String   // created | role_changed | activated | deactivated | availability_changed | group_changed | skill_changed
  field     String?
  fromValue String?
  toValue   String?
  actor     String   @default("system")
  note      String?
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([action])
}

// Sequence counter backing human-readable ticket numbers (INC-000001).
// year = 0 row is the global counter for the current numbering scheme.
model TicketSequence {
  year Int  @id
  last Int  @default(0)
}

model Ticket {
  id                  Int              @id @default(autoincrement())
  ticketNumber        String           @unique // e.g. HD-2026-000042
  shortDescription    String
  body                String           @default("")
  category            String           @default("Inquiry / Help")
  priority            String           @default("medium")
  state               String           @default("NEW")
  source              String           @default("email") // "email" | "portal"
  resolution          String?
  requesterEmail      String
  requesterName       String?
  graphMessageId      String?          @unique
  graphConversationId String?
  teamId              Int?
  team                Team?            @relation("TicketCurrentGroup", fields: [teamId], references: [id])
  // The group the ticket was first routed to. Set once at creation and never
  // changed, even when the current assignment group moves.
  originatingTeamId   Int?
  originatingTeam     Team?            @relation("TicketOriginGroup", fields: [originatingTeamId], references: [id])
  assignedAgentId     Int?
  assignedAgent       Agent?           @relation(fields: [assignedAgentId], references: [id])
  dueAt               DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  auditLogs           TicketAuditLog[]
  comments            Comment[]
  notifications       Notification[]
  handovers           HandoverRequest[]

  @@index([state])
  @@index([graphConversationId])
  @@index([dueAt])
}

model TicketAuditLog {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromState String?
  toState   String
  actor     String   @default("system")
  note      String?
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Comment {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorAgentId Int?
  authorAgent  Agent?   @relation(fields: [authorAgentId], references: [id])
  authorName   String   @default("")
  authorEmail  String   @default("")
  isRequester Boolean  @default(false)
  isInternal  Boolean  @default(false)
  viaEmail    Boolean  @default(false)
  body        String
  // Set for activities created from an inbound Graph/email message. Unique so a
  // redelivered notification can never append the same reply twice.
  graphMessageId String? @unique
  createdAt   DateTime @default(now())

  @@index([ticketId])
}

// Microsoft Graph change-notification subscription state. Persisted so a
// restart reuses (and renews) the live subscription instead of orphaning it.
model GraphSubscription {
  id                 Int      @id @default(autoincrement())
  subscriptionId     String   @unique
  resource           String
  notificationUrl    String
  clientState        String
  expirationDateTime DateTime
  lastRenewedAt      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// In-app notification for an agent. Email is sent separately through the
// existing notification service (src/mailer.js); this is the in-product feed,
// so an agent who was not watching their inbox still sees what happened to
// their tickets.
model Notification {
  id        Int       @id @default(autoincrement())
  agentId   Int
  agent     Agent     @relation("AgentNotifications", fields: [agentId], references: [id], onDelete: Cascade)
  ticketId  Int?
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  // ticket_taken | ticket_reassigned | ticket_rebalanced | availability_forced
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([agentId, readAt])
  @@index([ticketId])
}

// Agent-to-agent ticket handover.
//
// A handover is an OFFER: the ticket does not change owner until the target
// accepts. Everything about who may hold a ticket, how it moves and how people
// are told lives in the existing assignment/workload/notification services —
// this record only tracks the offer's lifecycle.
//
// status: PENDING | QUEUED | ACCEPTED | DECLINED | CANCELLED | EXPIRED
// Completed rows are never deleted: the ticket history is the chain of them.
model HandoverRequest {
  id               Int      @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // The agent giving the ticket away (its owner at the time of the request).
  requestedById    Int
  requestedBy      Agent    @relation("HandoverRequester", fields: [requestedById], references: [id])
  // The agent being asked to take it.
  targetAgentId    Int
  targetAgent      Agent    @relation("HandoverTarget", fields: [targetAgentId], references: [id])
  // Set when the target proposes somebody else instead. Advisory only: no
  // request is created for them, the original agent decides.
  suggestedAgentId Int?
  suggestedAgent   Agent?   @relation("HandoverSuggested", fields: [suggestedAgentId], references: [id])

  status           String   @default("PENDING")
  note             String?
  responseNote     String?
  // Who ended the request, for the history line ("Cancelled by ...").
  resolvedBy       String?

  // Queue position is FIFO by id among QUEUED rows for the same target, so it
  // is derived rather than stored and can never drift.
  queuedAt         DateTime?
  // When the request became PENDING; the expiry clock starts here.
  activatedAt      DateTime?
  expiresAt        DateTime?
  // Expiry is paused while the target is unavailable: expiresAt is cleared and
  // the remaining time parked here until they are available again.
  pausedAt         DateTime?
  remainingMs      Int?
  respondedAt      DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([targetAgentId, status])
  @@index([ticketId])
  @@index([status, expiresAt])
}

// Administrator-configurable runtime settings, as strings.
// Deliberately tiny: env vars supply the defaults, this table only holds
// values an administrator has actually overridden.
model Setting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt
}
