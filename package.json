{
  "name": "ticketing-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently -k -n api,ui -c blue,green \"npm:server\" \"npm:client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "scan:secrets": "node scripts/secret-scan.js --all",
    "scan:staged": "node scripts/secret-scan.js --staged",
    "hooks:install": "node scripts/install-hooks.js"
  },
  "dependencies": {
    "docx": "9.7.1",
    "express": "^4.22.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "@azure/msal-node": {
      "uuid": "^11.1.1"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
