{
  "name": "ticketing-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently -k -n api,ui -c blue,green \"npm:server\" \"npm:client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "scan:secrets": "node scripts/secret-scan.js --all",
    "scan:staged": "node scripts/secret-scan.js --staged",
    "hooks:install": "node scripts/install-hooks.js"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
